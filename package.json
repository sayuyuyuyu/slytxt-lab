{
  "name": "personal-lab-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && pagefind --site dist --glob \"**/*.html\"",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm run check:build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "fixture:ui": "node scripts/prepare-ui-fixture.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.11",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "pagefind": "^1.3.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.7.0"
  }
}
