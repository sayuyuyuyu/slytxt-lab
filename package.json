{
  "name": "personal-lab-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && pagefind --site dist --glob \"**/*.html\"",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm run check:build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "fixture:ui": "node scripts/prepare-ui-fixture.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "motion": "^14.10.1",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "astro>sharp": "^0.35.5",
      "astro>esbuild": "^0.28.1"
    }
  }
}
