{
  "name": "personal-lab-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && pagefind --site dist --glob \"**/*.html\"",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm run check:build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "fixture:ui": "node scripts/prepare-ui-fixture.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "motion": "^13.5.1",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "astro>sharp": "^0.35.5",
      "astro>esbuild": "^0.28.1"
    }
  }
}
