---
import { tagPath } from "@/lib/tags";

type Props = {
  tags: string[];
};

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" aria-label="タグ">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={tagPath(tag)}>
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
