---
import { tagFilterPath } from "@/lib/tags";

type Props = {
  tags: string[];
  /** 絞り込み先の一覧（記事なら /articles/、Projects なら /projects/）。 */
  base?: string;
};

const { tags, base = "/articles/" } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={tagFilterPath(base, tag)}>
            <span class="tag__hash" aria-hidden="true">#</span>{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
