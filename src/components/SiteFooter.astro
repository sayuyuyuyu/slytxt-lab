---
import { getAllEntries } from "@/lib/content";
import { getYear } from "@/lib/format";
import { collectTags } from "@/lib/tags";
import { site } from "@/lib/site";

const hasTags = collectTags(await getAllEntries()).size > 0;
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container site-footer__inner">
    <span class="site-footer__status"><span class="site-footer__dot" aria-hidden="true"></span>&copy; {getYear(new Date())} {site.name}</span>
    <nav class="footer-links" aria-label="Links">
      {hasTags && <a href="/tags/">Tags</a>}
      <a href="/rss.xml">RSS</a>
      <a href={site.xUrl} rel="me noreferrer">X</a>
      <a href={site.noteUrl} rel="me noreferrer">note</a>
    </nav>
  </div>
</footer>
