---
import { getEntryDate, getEntryPath, getEntryPreview, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels } from "@/lib/site";

type Props = {
  entry: ArticleEntry;
  headingLevel?: "h2" | "h3";
};

const { entry, headingLevel: Heading = "h3" } = Astro.props;
const date = getEntryDate(entry);
const preview = getEntryPreview(entry);
---

<article class="note-card" data-motion>
  {entry.data.cover && <img class="note-card__thumb" src={entry.data.cover} alt="" loading="lazy" />}
  <div class="note-card__meta">
    <span>{categoryLabels.notes}</span>
    <span aria-hidden="true"> / </span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
  <Heading class="note-card__title">
    <a class="note-card__text" href={getEntryPath(entry)}>{preview}</a>
  </Heading>
</article>
