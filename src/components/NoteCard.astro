---
import { getEntryDate, getEntryPath, toPlainText, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels } from "@/lib/site";

type Props = {
  entry: ArticleEntry;
};

const { entry } = Astro.props;
const date = getEntryDate(entry);
const lines = (entry.body ?? "")
  .trim()
  .split("\n")
  .filter((line) => line.trim());
const previewText = toPlainText(lines.slice(0, 3).join("\n"));
const previewChars = Array.from(previewText);
const preview = previewChars.length > 90 ? `${previewChars.slice(0, 90).join("")}…` : previewText;
---

<article class="note-card" data-motion>
  {entry.data.cover && <img class="note-card__thumb" src={entry.data.cover} alt="" loading="lazy" />}
  <div class="note-card__meta">
    <span>{categoryLabels.notes}</span>
    <span aria-hidden="true"> / </span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
  <a class="note-card__text" href={getEntryPath(entry)}>{preview}</a>
</article>
