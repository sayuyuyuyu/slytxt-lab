---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
};

const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  headings.length > 0 && (
    <aside class="toc" aria-label="目次" data-pagefind-ignore>
      <p class="toc__title">目次</p>
      <ol>
        {headings.map((heading) => (
          <li class={`depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </aside>
  )
}
