---
import { getEntryPath, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels } from "@/lib/site";
import TagList from "./TagList.astro";

type Props = {
  entry: ArticleEntry;
  headingLevel?: "h2" | "h3";
};

const { entry, headingLevel: Heading = "h3" } = Astro.props;
const date = entry.data.updated ?? entry.data.published;
---

<article class="entry-card" data-motion>
  <div class="entry-card__meta">
    <span>{categoryLabels[entry.collection]}</span>
    <span aria-hidden="true"> / </span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {entry.data.adult && <span aria-label="成人向け作品レビューを含む"> / 🔞</span>}
  </div>
  <Heading class="entry-card__title">
    <a href={getEntryPath(entry)}>{entry.data.title}</a>
  </Heading>
  <p>{entry.data.description}</p>
  <div class="entry-card__footer">
    <TagList tags={entry.data.tags} />
  </div>
</article>
