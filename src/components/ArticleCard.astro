---
import { getEntryDate, getEntryDisplayTitle, getEntryPath, getEntryPreview, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels } from "@/lib/site";
import TagList from "./TagList.astro";

type Props = {
  entry: ArticleEntry;
  headingLevel?: "h2" | "h3";
};

const { entry, headingLevel: Heading = "h3" } = Astro.props;
const date = getEntryDate(entry);
const displayTitle = getEntryDisplayTitle(entry);
const preview = getEntryPreview(entry);
const excerpt =
  entry.data.description && entry.data.description !== displayTitle
    ? entry.data.description
    : preview && preview !== displayTitle
      ? preview
      : undefined;
---

<article class:list={["entry-card", { "entry-card--with-thumb": entry.data.cover }]} data-motion>
  {entry.data.cover && <img class="entry-card__thumb" src={entry.data.cover} alt="" loading="lazy" />}
  <div class="entry-card__meta">
    <span>{categoryLabels[entry.collection]}</span>
    <span aria-hidden="true"> / </span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {entry.data.adult && <span role="img" aria-label="Includes an adult content review"> / 🔞</span>}
  </div>
  <Heading class="entry-card__title">
    <a href={getEntryPath(entry)}>{displayTitle}</a>
  </Heading>
  {excerpt && <p>{excerpt}</p>}
  {entry.data.tags.length > 0 && (
    <div class="entry-card__footer">
      <TagList tags={entry.data.tags} />
    </div>
  )}
</article>
