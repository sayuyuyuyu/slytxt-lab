<button class="theme-toggle" type="button" aria-label="テーマを切り替える" aria-pressed="false" data-theme-toggle hidden>
  <span class="theme-toggle__icon" aria-hidden="true" data-theme-icon>◐</span>
</button>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    const icon = document.querySelector("[data-theme-icon]");

    if (!button || !icon) return;

    const setIcon = () => {
      const light = document.documentElement.classList.contains("light");
      const next = light ? "ダークモードに切り替える" : "ライトモードに切り替える";
      icon.textContent = light ? "☼" : "☾";
      button.setAttribute("aria-pressed", String(!light));
      button.setAttribute("aria-label", next);
      button.setAttribute("title", next);
    };

    button.addEventListener("click", () => {
      const nextTheme = document.documentElement.classList.contains("light") ? "dark" : "light";
      const root = document.documentElement;
      // Animate the colour change only while switching, so scrolling stays cheap.
      root.classList.add("theme-switching");
      window.setTimeout(() => root.classList.remove("theme-switching"), 420);
      root.classList.toggle("light", nextTheme === "light");
      try {
        localStorage.setItem("theme", nextTheme);
      } catch {
        // Ignore storage errors so the toggle still works for the current page.
      }
      setIcon();
    });

    window.addEventListener("storage", (event) => {
      if (event.key !== "theme" && event.key !== null) return;
      document.documentElement.classList.toggle("light", event.newValue === "light");
      setIcon();
    });
    setIcon();
    button.hidden = false;
  })();
</script>
