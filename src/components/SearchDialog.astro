---
/**
 * 検索パネル。ヘッダーの検索ボタンで、ヘッダーのすぐ下に開く（中央のモーダル
 * にはしない）。Pagefind の UI と索引は初回に開いたときだけ読み込む。
 *
 * ここに説明文・プレースホルダ・「閉じる」ボタンを置かない。UI で示す
 * （AGENTS.md の UI 規範）。
 */
---

<div class="search-panel" data-search-overlay hidden>
  <div class="search-panel__inner">
    <div id="search" class="search-box"></div>
  </div>
</div>

<script is:inline>
  (() => {
    const start = () => {
      const panel = document.querySelector("[data-search-overlay]");
      if (!panel) return;

      const triggers = () => Array.from(document.querySelectorAll("[data-search-open]"));
      let loaded = false;
      let loading = null;
      let openedFrom = null;

      const load = () => {
        if (loaded) return Promise.resolve();
        if (loading) return loading;
        loading = new Promise((resolve, reject) => {
          const css = document.createElement("link");
          css.rel = "stylesheet";
          css.href = "/pagefind/pagefind-ui.css";
          document.head.append(css);

          const script = document.createElement("script");
          script.src = "/pagefind/pagefind-ui.js";
          script.onload = () => {
            try {
              new PagefindUI({
                element: "#search",
                showSubResults: true,
                showImages: false,
                translations: {
                  placeholder: "",
                  clear_search: "",
                  load_more: "",
                  search_label: "",
                  filters_label: "",
                  zero_results: "",
                  many_results: "",
                  one_result: "",
                  total_zero_results: "",
                  total_one_result: "",
                  total_many_results: "",
                  alt_search: "",
                  search_suggestion: "",
                  searching: "",
                  results_label: "",
                  error_search: "",
                  input_hint: "",
                  loading: ""
                }
              });
              loaded = true;
              resolve();
            } catch (error) {
              reject(error);
            }
          };
          script.onerror = reject;
          document.head.append(script);
        }).catch((error) => {
          loading = null;
          throw error;
        });
        return loading;
      };

      const focusInput = () => {
        const input = panel.querySelector(".pagefind-ui__search-input");
        if (!(input instanceof HTMLInputElement)) return;
        input.focus();
        input.select();
      };

      const open = async (from) => {
        openedFrom = from ?? document.activeElement;
        panel.hidden = false;
        try {
          await load();
          focusInput();
        } catch {
          panel.hidden = true;
        }
      };

      const close = () => {
        if (panel.hidden) return;
        panel.hidden = true;
        const target = openedFrom;
        openedFrom = null;
        if (target instanceof HTMLElement && document.contains(target)) target.focus();
      };

      for (const trigger of triggers()) {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          if (panel.hidden) void open(trigger);
          else close();
        });
      }

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !panel.hidden) close();
      });

      // パネルの外を押したら閉じる。
      document.addEventListener("click", (event) => {
        if (panel.hidden) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (panel.contains(target)) return;
        if (triggers().some((trigger) => trigger.contains(target))) return;
        close();
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }
  })();
</script>
