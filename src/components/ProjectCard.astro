---
import { getEntryDate, getEntryDisplayTitle, getEntryPath, getEntryPreview, type ProjectEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { projectStatusLabels } from "@/lib/site";
import TagList from "./TagList.astro";

type Props = {
  entry: ProjectEntry;
  headingLevel?: "h2" | "h3";
};

const { entry, headingLevel: Heading = "h3" } = Astro.props;
const date = getEntryDate(entry);
const displayTitle = getEntryDisplayTitle(entry);
const preview = getEntryPreview(entry);
const excerpt =
  entry.data.description !== displayTitle
    ? entry.data.description
    : preview && preview !== displayTitle
      ? preview
      : undefined;
---

<article class="project-card" data-motion>
  <div class="project-card__meta">
    <span class="status">{projectStatusLabels[entry.data.status]}</span>
    <span aria-hidden="true"> / </span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
  <Heading class="project-card__title">
    <a href={getEntryPath(entry)}>{displayTitle}</a>
  </Heading>
  {excerpt && <p>{excerpt}</p>}
  <TagList tags={entry.data.tags} />
</article>
