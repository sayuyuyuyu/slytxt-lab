---
import { ARTICLE_COLLECTIONS, getArticles, getProjects } from "@/lib/content";
import { categoryPaths, navGroups, site } from "@/lib/site";
import ThemeToggle from "./ThemeToggle.astro";
import SearchDialog from "./SearchDialog.astro";

const currentPath = Astro.url.pathname;

const [projects, ...perCategory] = await Promise.all([
  getProjects(),
  ...ARTICLE_COLLECTIONS.map((collection) => getArticles(collection))
]);

// Do not show a menu link to a section with no content (PR #19 rule).
// The pages themselves stay reachable by direct URL, and each link
// returns automatically once its section has published content.
// Child links (categories under Articles) follow their own counts.
const hiddenHrefs = new Set<string>();
const totalArticles = perCategory.reduce((sum, entries) => sum + entries.length, 0);
if (totalArticles === 0) hiddenHrefs.add("/articles/");
ARTICLE_COLLECTIONS.forEach((collection, index) => {
  if (perCategory[index].length === 0) hiddenHrefs.add(categoryPaths[collection]);
});
if (projects.length === 0) hiddenHrefs.add("/projects/");

const visibleNavGroups = navGroups
  .map((group) => ({
    ...group,
    items: group.items
      .filter((item) => !hiddenHrefs.has(item.href))
      .map((item) => {
        if (!item.children) return item;
        const children = item.children.filter((child) => !hiddenHrefs.has(child.href));
        return children.length > 0 ? { ...item, children } : { ...item, children: undefined };
      })
  }))
  .filter((group) => group.items.length > 0);

// aria-current="page" is only for the link that points at this page itself.
// An ancestor (e.g. Articles above /articles/tech/) keeps a visual hint via
// data-current-section instead, so a page never carries two aria-current.
function isCurrentPage(href: string) {
  return currentPath === href;
}

function isCurrentSection(href: string) {
  return currentPath !== href && currentPath.startsWith(href);
}
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand__name">{site.name}</span>
    </a>
    <div class="site-header__actions">
      <button
        class="search-button"
        type="button"
        aria-label="検索"
        title="検索"
        aria-haspopup="dialog"
        data-search-open
      >
        <span class="search-button__icon" aria-hidden="true">⌕</span>
      </button>
      <button
        class="menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-button
      >
        <span class="menu-button__bar" aria-hidden="true"></span>
        <span class="menu-button__bar" aria-hidden="true"></span>
      </button>
      <ThemeToggle />
    </div>
    <div class="site-menu" id="site-menu" data-menu hidden>
    <nav aria-label="Main">
      {
        visibleNavGroups.map((group) => (
          <div class="site-menu__group">
            <p class="site-menu__label" aria-hidden="true">{group.label}</p>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrentPage(item.href) ? "page" : undefined}
                    data-current-section={isCurrentSection(item.href) ? "true" : undefined}
                  >
                    {item.label}
                  </a>
                  {item.children && (
                    <ul class="site-menu__sub">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={isCurrentPage(child.href) ? "page" : undefined}
                            data-current-section={isCurrentSection(child.href) ? "true" : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      </nav>
    </div>
  </div>
  <SearchDialog />
  <noscript>
    <style>
      .site-menu[hidden] {
        display: block !important;
        position: static;
      }
      .menu-button {
        display: none;
      }
    </style>
  </noscript>
</header>

<script>
  (() => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!header || !button || !menu) return;

    // PC 幅ではナビを常時インライン表示する（ハンバーガーは出さない）。
    // 開閉の状態を持ち込むと hidden が残って消えるため、操作は張らない。
    const narrow = window.matchMedia("(max-width: 899px)");

    /**
     * 幅に応じてナビの出し方を揃える。
     * PC 幅は常時インライン（hidden を外し、ハンバーガーを隠す）。
     * モバイル幅はハンバーガーを出し、パネルは閉じた状態から始める。
     * 画面幅をまたいで変えたときも、属性が残って消えないようにする。
     */
    const syncMenuForWidth = () => {
      if (narrow.matches) {
        button.hidden = false;
        button.setAttribute("aria-expanded", "false");
        header.dataset.open = "false";
        menu.hidden = true;
      } else {
        button.hidden = true;
        menu.hidden = false;
      }
    };
    syncMenuForWidth();
    // 幅をまたいだときだけ揃える。resize をそのまま使うと、iOS Safari の
    // アドレスバー伸縮のように高さだけが変わる場面でも開いたメニューが
    // 閉じてしまう（#886）。
    narrow.addEventListener("change", syncMenuForWidth);

    const isOpen = () => button.getAttribute("aria-expanded") === "true";

    const menuLinks = () => Array.from(menu.querySelectorAll<HTMLAnchorElement>("a"));

    // 閉じる動き: 開く側は CSS の menu-in が担う。閉じる側は即座に消すと
    // 唐突なので、短いフェードを WAAPI で付けてから hidden に戻す。
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let closeAnimation: Animation | null = null;

    const setOpen = (open: boolean, options: { returnFocus?: boolean } = {}) => {
      const returnFocus = options.returnFocus ?? menu.contains(document.activeElement);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      header.dataset.open = String(open);
      if (open) {
        closeAnimation?.cancel();
        closeAnimation = null;
        menu.hidden = false;
        header.dataset.hidden = "false";
        // 開いたら最初の項目へ移し、Tab の流れを視覚順に合わせる
        // （DOM 上は ThemeToggle がメニューより前にあるため、このままでは
        // ボタンの次の Tab がテーマ切替へ進んでしまう）。
        menuLinks()[0]?.focus();
      } else {
        if (returnFocus) button.focus();
        if (reduceMotion || typeof menu.animate !== "function") {
          menu.hidden = true;
        } else {
          closeAnimation = menu.animate(
            [
              { opacity: 1, transform: "translateY(0)" },
              { opacity: 0, transform: "translateY(-6px)" }
            ],
            { duration: 160, easing: "ease-in" }
          );
          closeAnimation.onfinish = () => {
            menu.hidden = true;
            closeAnimation = null;
          };
        }
      }
    };

    button.addEventListener("click", () => setOpen(!isOpen()));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false, { returnFocus: true });
      }
    });

    document.addEventListener("click", (event) => {
      if (!isOpen()) return;
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    // 矢印キー / Home / End で項目間を移動する。
    menu.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
      const links = menuLinks();
      if (links.length === 0) return;
      event.preventDefault();
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === "Home") links[0].focus();
      else if (event.key === "End") links[links.length - 1].focus();
      else if (event.key === "ArrowDown") links[index < 0 ? 0 : (index + 1) % links.length].focus();
      else links[index < 0 ? links.length - 1 : (index - 1 + links.length) % links.length].focus();
    });

    // Tab でメニューの外へ出たら閉じる（フォーカスは移動先へそのまま渡す）。
    // 移動先が分からない場合（relatedTarget が null）は閉じない。iOS Safari では
    // トグルボタンをタップしてもフォーカスがボタンへ移らず body に落ちるため、
    // その状態で閉じると直後の click が「開く」に化けてトグルが反応しなくなる。
    // 移動先が実在する要素のときだけ閉じれば、Tab 移動での自動クローズは保たれる。
    menu.addEventListener("focusout", (event) => {
      if (!isOpen()) return;
      const next = event.relatedTarget as Node | null;
      if (!next) return;
      if (menu.contains(next) || next === button) return;
      setOpen(false, { returnFocus: false });
    });

    // Hide the header while scrolling down and bring it back on the way up.
    const REVEAL_ABOVE = 120;
    let lastY = window.scrollY;
    let frame = 0;
    const update = () => {
      frame = 0;
      const y = window.scrollY;
      header.dataset.scrolled = String(y > 8);
      const delta = y - lastY;
      if (Math.abs(delta) < 6) return;
      const hide = delta > 0 && y > REVEAL_ABOVE && !isOpen();
      header.dataset.hidden = String(hide);
      lastY = y;
    };
    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true }
    );
  })();
</script>
