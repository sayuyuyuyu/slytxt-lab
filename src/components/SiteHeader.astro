---
import { getAllEntries, getArticles, getNotes, getProjects } from "@/lib/content";
import { collectTags } from "@/lib/tags";
import { navGroups, site } from "@/lib/site";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;

const [projects, allEntries, tech, journal, notes] = await Promise.all([
  getProjects(),
  getAllEntries(),
  getArticles("tech"),
  getArticles("journal"),
  getNotes()
]);
const hasTags = collectTags(allEntries).size > 0;

// Do not show a menu link to a section with no content (PR #19 rule).
// The pages themselves stay reachable by direct URL, and each link
// returns automatically once its section has published content.
// Child links (Tech / Journal under Articles) follow their own counts.
const hiddenHrefs = new Set<string>();
if (tech.length + journal.length === 0) hiddenHrefs.add("/articles/");
if (tech.length === 0) hiddenHrefs.add("/articles/tech/");
if (journal.length === 0) hiddenHrefs.add("/articles/journal/");
if (projects.length === 0) hiddenHrefs.add("/projects/");
if (notes.length === 0) hiddenHrefs.add("/notes/");
if (!hasTags) hiddenHrefs.add("/tags/");

const visibleNavGroups = navGroups
  .map((group) => ({
    ...group,
    items: group.items
      .filter((item) => !hiddenHrefs.has(item.href))
      .map((item) => {
        if (!item.children) return item;
        const children = item.children.filter((child) => !hiddenHrefs.has(child.href));
        return children.length > 0 ? { ...item, children } : { ...item, children: undefined };
      })
  }))
  .filter((group) => group.items.length > 0);

// aria-current="page" is only for the link that points at this page itself.
// An ancestor (e.g. Articles above /articles/tech/) keeps a visual hint via
// data-current-section instead, so a page never carries two aria-current.
function isCurrentPage(href: string) {
  return currentPath === href;
}

function isCurrentSection(href: string) {
  return currentPath !== href && currentPath.startsWith(href);
}
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand__mark" aria-hidden="true">❯</span>
      <span class="brand__name">{site.name}</span>
      <span class="brand__cursor" aria-hidden="true"></span>
    </a>
    <div class="site-header__actions">
      <button
        class="menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-button
      >
        <span class="menu-button__bar" aria-hidden="true"></span>
        <span class="menu-button__bar" aria-hidden="true"></span>
      </button>
      <ThemeToggle />
    </div>
  </div>
  <div class="site-menu" id="site-menu" data-menu hidden>
    <nav aria-label="Main">
      {
        visibleNavGroups.map((group) => (
          <div class="site-menu__group">
            <p class="site-menu__label" aria-hidden="true">{group.label}</p>
            <ul>
              {group.items.map((item) => (
                <li class:list={["site-menu__item", { "site-menu__item--branch": item.children }]}>
                  <a
                    href={item.href}
                    aria-current={isCurrentPage(item.href) ? "page" : undefined}
                    data-current-section={isCurrentSection(item.href) ? "true" : undefined}
                  >
                    {item.label}
                  </a>
                  {item.children && (
                    <ul class="site-menu__sub">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={isCurrentPage(child.href) ? "page" : undefined}
                            data-current-section={isCurrentSection(child.href) ? "true" : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <noscript>
    <style>
      .site-menu[hidden] {
        display: block !important;
        position: static;
      }
      .menu-button {
        display: none;
      }
    </style>
  </noscript>
</header>

<script>
  (() => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!header || !button || !menu) return;

    const isOpen = () => button.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
      header.dataset.open = String(open);
      if (open) header.dataset.hidden = "false";
    };

    button.addEventListener("click", () => setOpen(!isOpen()));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (!isOpen()) return;
      if (!header.contains(event.target as Node)) setOpen(false);
    });

    // Hide the header while scrolling down and bring it back on the way up.
    const REVEAL_ABOVE = 120;
    let lastY = window.scrollY;
    let frame = 0;
    const update = () => {
      frame = 0;
      const y = window.scrollY;
      header.dataset.scrolled = String(y > 8);
      const delta = y - lastY;
      if (Math.abs(delta) < 6) return;
      const hide = delta > 0 && y > REVEAL_ABOVE && !isOpen();
      header.dataset.hidden = String(hide);
      lastY = y;
    };
    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true }
    );
  })();
</script>
