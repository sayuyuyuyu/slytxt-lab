---
import { getPageNumbers } from "@/lib/content";

type Props = {
  basePath: string;
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
};

const { basePath, currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="ページネーション" data-pagefind-ignore>
      {prevUrl ? <a href={prevUrl}>前へ</a> : <span aria-disabled="true">前へ</span>}
      {getPageNumbers(totalPages).map((page) => {
        const href = page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`;
        return page === currentPage ? (
          <span aria-current="page">{page}</span>
        ) : (
          <a href={href}>{page}</a>
        );
      })}
      {nextUrl ? <a href={nextUrl}>次へ</a> : <span aria-disabled="true">次へ</span>}
    </nav>
  )
}
