---
import { pagePath, visiblePages } from "@/lib/pagination";

type Props = {
  basePath: string;
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
};

const { basePath, currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination" data-pagefind-ignore>
      {prevUrl ? <a href={prevUrl}>Prev</a> : <span aria-disabled="true">Prev</span>}
      {visiblePages(currentPage, totalPages).map((page) => {
        if (page === "gap") return <span class="pagination__gap" aria-hidden="true">…</span>;
        const href = pagePath(basePath, page);
        return page === currentPage ? (
          <span aria-current="page">{page}</span>
        ) : (
          <a href={href} aria-label={`Page ${page}`}>{page}</a>
        );
      })}
      {nextUrl ? <a href={nextUrl}>Next</a> : <span aria-disabled="true">Next</span>}
    </nav>
  )
}
