---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { site } from "@/lib/site";
---
<BaseLayout title={`Search - ${site.name}`} description="記事とつくったものを、書いてある言葉から探せます。" noindex>
  <PageHeader title="Search" eyebrow="search" />
  <section class="listing" aria-label="Search"><div class="container">
    <div class="search-box">
      <div id="search"></div>
      <p id="search-status" class="muted" role="status">Loading search…</p>
      <noscript><p>Search needs JavaScript. You can also browse <a href="/tags/">Tags</a>.</p></noscript>
    </div>
    <p class="search-help">Short words match more.</p>
  </div></section>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline>
    (() => {
      const status = document.getElementById("search-status");
      const fail = () => { status.textContent = "Could not load search. Reload the page or browse Tags."; };
      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => {
        try {
          new PagefindUI({ element: "#search", showSubResults: true, showImages: false,
            translations: { placeholder: "Search", zero_results: "No results for \"[SEARCH_TERM]\"" }
          });
          status.hidden = true;
        } catch { fail(); }
      };
      script.onerror = fail;
      document.head.appendChild(script);
    })();
  </script>
  <noscript><style>#search-status { display: none; }</style></noscript>
</BaseLayout>
