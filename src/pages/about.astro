---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { categoryLabels, pageDescriptions, site } from "@/lib/site";
---

<BaseLayout searchable title={`About - ${site.name}`} description={pageDescriptions.about}>
  <PageHeader eyebrow="about" title="About" searchable />
  <section class="section" data-motion>
    <div class="container">
      <article class="article-main article-body" data-pagefind-filter={`category:${categoryLabels.about}`}>
        <p>しらゆ（slytxt）とは、都内某所でSEとして働いている一介のプロ社畜。2003年に爆誕し、地方都市にて私腹を肥やす。</p>
        <p>酒とつまみを好み、爆音のクラブで暴れることを生きがいとする。</p>
        <p>刹那的な快楽を常に求めているらしい。</p>
      </article>
    </div>
  </section>
  <section class="section" aria-labelledby="status-title" data-motion data-pagefind-ignore>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">status</p>
          <h2 id="status-title">いまの状態</h2>
        </div>
      </div>
      <div class="status-panel" data-status-panel>
        <p class="status-panel__cmd"><span class="prompt" aria-hidden="true">$</span>health check</p>
        <p class="status-panel__state" data-status-field="state" role="status" aria-live="polite">読み込み中…</p>
        <noscript>
          <style>
            .status-panel__state[data-status-field],
            .status-panel__list {
              display: none;
            }
          </style>
          <p class="status-panel__state">状態の表示には JavaScript が必要です。</p>
        </noscript>
        <dl class="status-panel__list">
          <div>
            <dt>心拍</dt>
            <dd data-status-field="heart">—</dd>
          </div>
          <div>
            <dt>安静時心拍</dt>
            <dd data-status-field="resting">—</dd>
          </div>
          <div>
            <dt>睡眠</dt>
            <dd data-status-field="sleep">—</dd>
          </div>
          <div>
            <dt>歩数</dt>
            <dd data-status-field="steps">—</dd>
          </div>
          <div>
            <dt>最終更新</dt>
            <dd data-status-field="updated">—</dd>
          </div>
        </dl>
        <p class="status-panel__note">Apple Health の記録から自動で更新しています。</p>
      </div>
    </div>
  </section>
  <script>
    (() => {
      const panel = document.querySelector("[data-status-panel]");
      if (!panel) return;
      const setText = (name: string, text: string): void => {
        const el = panel.querySelector(`[data-status-field="${name}"]`);
        if (el) el.textContent = text;
      };
      const dateTimeFmt = new Intl.DateTimeFormat("ja-JP", {
        month: "numeric",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
      const dateFmt = new Intl.DateTimeFormat("ja-JP", {
        month: "numeric",
        day: "numeric"
      });
      const formatAt = (value: string): string => {
        // 日次集計からしか取れない値は日付（YYYY-MM-DD）だけになることがある。
        if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
          const d = new Date(`${value}T00:00:00`);
          return Number.isNaN(d.getTime()) ? "" : dateFmt.format(d);
        }
        const d = new Date(value);
        return Number.isNaN(d.getTime()) ? "" : dateTimeFmt.format(d);
      };
      const numFmt = new Intl.NumberFormat("ja-JP");
      fetch("https://status.slytxt.dev/api/status", { signal: AbortSignal.timeout(5000) })
        .then((res) => {
          if (!res.ok) throw new Error(`status ${res.status}`);
          return res.json();
        })
        .then((data) => {
          setText("state", data.status ?? "不明");
          if (data.heart_rate_bpm != null) {
            const at = data.heart_rate_at ? formatAt(data.heart_rate_at) : "";
            setText(
              "heart",
              `${data.heart_rate_bpm} bpm` + (at ? `（${at}）` : "")
            );
          }
          if (data.resting_heart_rate_bpm != null) {
            const at = data.resting_heart_rate_at ? formatAt(data.resting_heart_rate_at) : "";
            setText("resting", `${data.resting_heart_rate_bpm} bpm` + (at ? `（${at}）` : ""));
          }
          const parseDate = (value: string): Date | null => {
            const d = /^\d{4}-\d{2}-\d{2}$/.test(value)
              ? new Date(`${value}T00:00:00`)
              : new Date(value);
            return Number.isNaN(d.getTime()) ? null : d;
          };
          const isToday = (d: Date): boolean => {
            const now = new Date();
            return (
              d.getFullYear() === now.getFullYear() &&
              d.getMonth() === now.getMonth() &&
              d.getDate() === now.getDate()
            );
          };
          if (data.sleep_hours != null) {
            // sleep_date はその睡眠が終わった日。当日なら「昨夜」、違う日なら日付を併記し、
            // 解釈できない・無い場合は日付も「昨夜」も付けない（心拍の日時併記と同じ方針）。
            let label = `${data.sleep_hours} 時間`;
            if (data.sleep_date) {
              const at = formatAt(data.sleep_date);
              const d = parseDate(data.sleep_date);
              if (at && d) label = isToday(d) ? `昨夜 ${label}` : `${label}（${at}）`;
            }
            setText("sleep", label);
          }
          if (data.steps_today != null) {
            // 歩数には日付項目が無いため、updated_at が今日のときだけ「今日」と言う。
            let label = `${numFmt.format(data.steps_today)} 歩`;
            if (data.updated_at) {
              const at = formatAt(data.updated_at);
              const d = parseDate(data.updated_at);
              if (at && d) label = isToday(d) ? `今日 ${label}` : `${label}（${at}）`;
            }
            setText("steps", label);
          }
          if (data.updated_at) {
            const at = formatAt(data.updated_at);
            if (at) setText("updated", at);
          }
        })
        .catch(() => {
          setText("state", "取得できませんでした");
        });
    })();
  </script>
</BaseLayout>
