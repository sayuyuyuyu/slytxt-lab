---
import { getArticles } from "@/lib/content";
import { pageCount, paginateEntries } from "@/lib/pagination";
import ArticleListing from "@/layouts/ArticleListing.astro";
export async function getStaticPaths() {
  const entries = await getArticles("tech");
  return Array.from({ length: pageCount(entries.length) - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: paginateEntries(entries, "/tech", index + 2) }
  }));
}
const { page } = Astro.props;
---
<ArticleListing collection="tech" page={page} />
