---
import ArticleCard from "@/components/ArticleCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getArticles, getProjects, sortArticles } from "@/lib/content";
import { site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
const [tech, life, projects] = await Promise.all([getArticles("tech"), getArticles("life"), getProjects()]);
const recent = sortArticles([...tech, ...life]).slice(0, 6);
---
<BaseLayout>
  <section class="container home-hero" aria-labelledby="intro-title">
    <h1 id="intro-title">{site.name}</h1>
    <nav class="home-hero__links" aria-label="記事と制作物">
      <a href="/tech/">技術メモ <span>{tech.length}件</span></a>
      <a href="/life/">日々の記録 <span>{life.length}件</span></a>
      <a href="/projects/">つくったもの <span>{projects.length}件</span></a>
      <a href="/tags/">タグ</a>
    </nav>
  </section>
  <section class="section" aria-labelledby="recent-title">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">recent notes</p><h2 id="recent-title">最近書いたこと</h2></div>
        <div class="section-links"><a href="/tech/">技術メモ</a><a href="/life/">日々の記録</a><a href="/rss.xml">RSS</a></div>
      </div>
      {recent.length ? <div class="listing-list">{recent.map((entry) => <ArticleCard entry={entry} />)}</div> : <EmptyState title="まだ記事はありません" description="試したことや、気に入ったものをここに置きます。" />}
    </div>
  </section>
  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">projects</p><h2 id="projects-title">つくったもの</h2></div>
        <a class="link-button" href="/projects/">すべて見る <span aria-hidden="true">↗</span></a>
      </div>
      {projects.length ? <div class="project-grid">{projects.slice(0, 4).map((entry) => <ProjectCard entry={entry} />)}</div> : <EmptyState title="まだ公開できるものはありません" description="形になったものから、進み具合と一緒に置きます。" />}
    </div>
  </section>
</BaseLayout>
