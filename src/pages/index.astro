---
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getAllArticles, getProjects } from "@/lib/content";
import { site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
const [articles, projects] = await Promise.all([getAllArticles(), getProjects()]);
const recent = articles.slice(0, 6);
---
<BaseLayout>
  <h1 class="sr-only">{site.name}</h1>

  {recent.length > 0 && (
  <section class="section" aria-labelledby="recent-title" data-motion>
    <div class="container">
      <div class="section-head">
        <h2 id="recent-title">Articles</h2>
        <div class="section-links"><a class="link-button" href="/articles/">All articles <span aria-hidden="true">↗</span></a><a class="link-button" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="listing-list">{recent.map((entry) => <ArticleCard entry={entry} />)}</div>
    </div>
  </section>
  )}

  <!-- フィードの区画。投稿が0件のときは Pages Functions（handleHomeFeed）が
       区画ごと取り除くので、区画の外側も目印で囲む。 -->
  <Fragment set:html="<!--feed:section:start-->" />
  <section class="section" aria-labelledby="feed-title" data-motion>
    <div class="container">
      <div class="section-head">
        <h2 id="feed-title">Feed</h2>
        <a class="link-button" href="/feed/">All posts <span aria-hidden="true">↗</span></a>
      </div>
      <div class="feed feed--home" data-pagefind-ignore>
        <!--feed:start--><p class="feed-empty">まだ投稿がありません。</p><!--feed:end-->
      </div>
    </div>
  </section>
  <Fragment set:html="<!--feed:section:end-->" />

  {projects.length > 0 && (
  <section class="section" aria-labelledby="projects-title" data-motion>
    <div class="container">
      <div class="section-head">
        <h2 id="projects-title">Projects</h2>
        <a class="link-button" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">{projects.slice(0, 4).map((entry) => <ProjectCard entry={entry} />)}</div>
    </div>
  </section>
  )}
</BaseLayout>
