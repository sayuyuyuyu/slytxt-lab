---
import ArticleCard from "@/components/ArticleCard.astro";
import NoteCard from "@/components/NoteCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getAllArticles, getAllEntries, getArticles, getNotes, getProjects } from "@/lib/content";
import { articleSections, articlesIndex, pageDescriptions, site } from "@/lib/site";
import { collectTags } from "@/lib/tags";
import BaseLayout from "@/layouts/BaseLayout.astro";
const [articles, notes, projects, allEntries, tech, journal] = await Promise.all([getAllArticles(), getNotes(), getProjects(), getAllEntries(), getArticles("tech"), getArticles("journal")]);
const hasTags = collectTags(allEntries).size > 0;
const recent = articles.slice(0, 6);
const recentNotes = notes.slice(0, 4);
// Config for the playable terminal in the hero: which collections actually
// have a page worth opening right now.
const terminalConfig = {
  description: site.description,
  counts: { articles: articles.length, tech: tech.length, journal: journal.length, notes: notes.length, projects: projects.length },
  descriptions: {
    articles: articlesIndex.description,
    tech: articleSections.tech.description,
    journal: articleSections.journal.description,
    notes: articleSections.notes.description,
    projects: pageDescriptions.projects,
    tags: pageDescriptions.tags,
    search: pageDescriptions.search,
    about: pageDescriptions.about
  },
  hasTags
};
---
<BaseLayout>
  <section class="home-hero" aria-labelledby="intro-title" data-motion>
    <div class="container">
      <div class="terminal" data-terminal>
        <div class="terminal__bar" aria-hidden="true">
          <span class="terminal__dot terminal__dot--red"></span>
          <span class="terminal__dot terminal__dot--yellow"></span>
          <span class="terminal__dot terminal__dot--green"></span>
          <span class="terminal__title">{site.name} — zsh</span>
        </div>
        <div class="home-hero__body">
          <p class="terminal__cmd">
            <span class="prompt" aria-hidden="true">$</span>
            <span class="terminal__cmd-text">cat intro.txt</span>
          </p>
          <h1 id="intro-title">{site.name}</h1>
          <nav class="home-hero__links" aria-label="Writing and projects">
            {articles.length > 0 && <a href="/articles/">Articles <span>{articles.length}</span></a>}
            {notes.length > 0 && <a href="/notes/">Notes <span>{notes.length}</span></a>}
            {projects.length > 0 && <a href="/projects/">Projects <span>{projects.length}</span></a>}
            {hasTags && <a href="/tags/">Tags</a>}
          </nav>
        </div>
        <div class="terminal__console" data-play-terminal>
          <div class="terminal__output" data-terminal-output role="log" aria-label="Terminal output"></div>
          <div class="terminal__suggestions" data-terminal-suggestions hidden></div>
          <form class="terminal__input-line" data-terminal-form>
            <label class="terminal__prompt" for="play-terminal-input">guest@slytxt-lab:~$</label>
            <input
              id="play-terminal-input"
              class="terminal__input"
              data-terminal-input
              type="text"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              aria-label="Terminal command"
              placeholder="help"
            />
            <button type="submit" class="terminal__enter" aria-label="Run command">⏎</button>
          </form>
        </div>
      </div>
    </div>
  </section>
  {recent.length > 0 && (
  <section class="section" aria-labelledby="recent-title" data-motion>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">recent articles</p><h2 id="recent-title">Recent</h2></div>
        <div class="section-links"><a href="/articles/">Articles</a><a href="/rss.xml">RSS</a></div>
      </div>
      <div class="listing-list">{recent.map((entry) => <ArticleCard entry={entry} />)}</div>
    </div>
  </section>
  )}
  {recentNotes.length > 0 && (
  <section class="section" aria-labelledby="notes-title" data-motion>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">notes</p><h2 id="notes-title">Notes</h2></div>
        <a class="link-button" href="/notes/">All notes <span aria-hidden="true">↗</span></a>
      </div>
      <div class="listing-list">{recentNotes.map((entry) => <NoteCard entry={entry} />)}</div>
    </div>
  </section>
  )}
  {projects.length > 0 && (
  <section class="section" aria-labelledby="projects-title" data-motion>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">projects</p><h2 id="projects-title">Projects</h2></div>
        <a class="link-button" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">{projects.slice(0, 4).map((entry) => <ProjectCard entry={entry} />)}</div>
    </div>
  </section>
  )}
  <script define:vars={{ terminalConfig }}>
    (() => {
      const root = document.querySelector("[data-play-terminal]");
      if (!root) return;
      const output = root.querySelector("[data-terminal-output]");
      const form = root.querySelector("[data-terminal-form]");
      const input = root.querySelector("[data-terminal-input]");
      const suggestions = root.querySelector("[data-terminal-suggestions]");
      if (!output || !form || !input || !suggestions) return;

      const PROMPT = "guest@slytxt-lab:~$";

      // Pages a visitor can actually open. A collection with nothing in it
      // (or tags, while there are none) has no page worth sending people to.
      const pages = {
        articles: {
          path: terminalConfig.counts.articles > 0 ? "/articles/" : null,
          description: terminalConfig.descriptions.articles
        },
        tech: {
          path: terminalConfig.counts.tech > 0 ? "/articles/tech/" : null,
          description: terminalConfig.descriptions.tech
        },
        journal: {
          path: terminalConfig.counts.journal > 0 ? "/articles/journal/" : null,
          description: terminalConfig.descriptions.journal
        },
        notes: {
          path: terminalConfig.counts.notes > 0 ? "/notes/" : null,
          description: terminalConfig.descriptions.notes
        },
        projects: {
          path: terminalConfig.counts.projects > 0 ? "/projects/" : null,
          description: terminalConfig.descriptions.projects
        },
        tags: {
          path: terminalConfig.hasTags ? "/tags/" : null,
          description: terminalConfig.descriptions.tags
        },
        search: { path: "/search/", description: terminalConfig.descriptions.search },
        about: { path: "/about/", description: terminalConfig.descriptions.about },
        bookmarks: { path: null, description: "ブックマークは非公開にしています。" }
      };

      const mokaLines = [
        "モカです。隣で紅茶を飲みながら見てます。",
        "モカです。そのコマンド、いいと思います。",
        "モカです。……無理しないでくださいね。"
      ];

      const scrollDown = () => {
        output.scrollTop = output.scrollHeight;
      };

      const print = (text) => {
        const line = document.createElement("div");
        line.className = "terminal__line";
        line.textContent = text;
        output.appendChild(line);
        scrollDown();
      };

      const printBlock = (text) => {
        const block = document.createElement("pre");
        block.className = "terminal__block";
        block.textContent = text;
        output.appendChild(block);
        scrollDown();
      };

      const printLink = (label, href) => {
        const line = document.createElement("div");
        line.className = "terminal__line";
        const anchor = document.createElement("a");
        anchor.href = href;
        anchor.textContent = label;
        line.append("→ ", anchor);
        output.appendChild(line);
        scrollDown();
      };

      const echoCommand = (raw) => {
        const line = document.createElement("div");
        line.className = "terminal__line terminal__line--cmd";
        const prompt = document.createElement("span");
        prompt.className = "terminal__prompt";
        prompt.textContent = PROMPT;
        line.append(prompt, document.createTextNode(` ${raw}`));
        output.appendChild(line);
        scrollDown();
      };

      const lsNames = () => {
        const names = ["about", "intro.txt"];
        for (const [name, page] of Object.entries(pages)) {
          if (name === "about" || name === "bookmarks") continue;
          if (page.path) names.push(`${name}/`);
        }
        return names.sort();
      };

      const resolvePage = (name) => pages[name.replace(/\/$/, "")];

      const openPage = (name) => {
        if (!name) {
          print("open: 開くページを指定してください。ls で一覧が見られます。");
          return;
        }
        const page = resolvePage(name);
        if (!page) {
          print(`open: ${name}: そのページはありません。ls で一覧が見られます。`);
          return;
        }
        if (!page.path) {
          print(page.description);
          return;
        }
        print(`${page.path} を開きます。`);
        window.location.assign(page.path);
      };

      const describePage = (name) => {
        const page = pages[name];
        print(page.description);
        if (page.path) {
          printLink(page.path, page.path);
          print(`開くには open ${name} でも構いません。`);
        }
      };

      const commands = {
        help() {
          // Narrow screens cannot fit the two columns without sideways
          // scrolling, so each command gets its own line there and the
          // description follows indented. The wording is unchanged.
          if (window.matchMedia("(max-width: 600px)").matches) {
            printBlock(
              [
                "使えるコマンド:",
                "  help",
                "    この一覧",
                "  about",
                "    管理人の紹介",
                "  ls",
                "    ページとファイルの一覧",
                "  open <ページ>",
                "    ページを開く（例: open notes）",
                "  articles / notes / projects /",
                "  tags / search / about",
                "    各ページの案内",
                "  whoami",
                "    あなたは誰か",
                "  date",
                "    現在の日時",
                "  echo <文字>",
                "    そのまま表示する",
                "  clear",
                "    出力を消す",
                "  cat / tea / moka / sudo",
                "    小ネタ"
              ].join("\n")
            );
            return;
          }
          printBlock(
            [
              "使えるコマンド:",
              "  help              この一覧",
              "  about             管理人の紹介",
              "  ls                ページとファイルの一覧",
              "  open <ページ>     ページを開く（例: open notes）",
              "  articles / notes / projects / tags / search / about",
              "                    各ページの案内",
              "  whoami            あなたは誰か",
              "  date              現在の日時",
              "  echo <文字>       そのまま表示する",
              "  clear             出力を消す",
              "  cat / tea / moka / sudo   小ネタ"
            ].join("\n")
          );
        },
        about() {
          print("しらゆ（slytxt）。都内某所で SE として働いている人。");
          print("このサイトは、AI やクラウドを試した記録と日々のこと、つくったものの置き場です。");
          print("詳しくは about ページにあります。開くには open about。");
        },
        ls() {
          print(lsNames().join("  "));
        },
        open(args) {
          openPage(args[0]);
        },
        cd(args) {
          openPage(args[0]);
        },
        whoami() {
          print("guest — 通りすがりの訪問者です。ログインは要りません。");
        },
        date() {
          const now = new Date();
          const day = now.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric", weekday: "short" });
          print(`${day} ${now.toLocaleTimeString("ja-JP")}`);
        },
        echo(args) {
          print(args.join(" "));
        },
        clear() {
          output.replaceChildren();
        },
        cat(args) {
          const target = args[0];
          if (!target) {
            printBlock([" /\\_/\\", "( o.o )", " > ^ <"].join("\n"));
            print("猫です。ターミナルの隅に住んでいます。");
            return;
          }
          if (target === "intro.txt") {
            print(terminalConfig.description);
            print("— intro.txt");
            return;
          }
          print(`cat: ${target}: No such file or directory`);
        },
        sudo() {
          print("[sudo] guest のパスワード: ********");
          print("guest は sudoers に含まれていません。この件は記録……されません。安心してください。");
        },
        moka() {
          print(mokaLines[Math.floor(Math.random() * mokaLines.length)]);
        },
        tea() {
          print("紅茶を淹れました。今日はダージリンです。");
        },
        exit() {
          print("ログアウトできません。タブを閉じるのは、あなたの仕事です。");
        },
        logout() {
          commands.exit();
        }
      };

      const pageCommands = ["articles", "tech", "journal", "notes", "projects", "tags", "search", "about", "bookmarks"];
      for (const name of pageCommands) {
        commands[name] = () => describePage(name);
      }

      const run = (raw) => {
        const [name, ...args] = raw.trim().split(/\s+/);
        const command = commands[name];
        if (command) {
          command(args);
        } else {
          print(`command not found: ${name} — help と入力すると使えるコマンドが出ます。`);
        }
      };

      // History, shell-style: up/down walk it, the in-progress line is kept.
      const history = [];
      let historyIndex = -1;
      let draft = "";

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const raw = input.value;
        echoCommand(raw);
        if (raw.trim()) {
          history.push(raw);
          run(raw);
        }
        historyIndex = -1;
        draft = "";
        input.value = "";
        updateSuggestions();
        input.focus({ preventScroll: true });
      });

      const completionsFor = (value) => {
        const openMatch = value.match(/^(open|cd)\s+(\S*)$/);
        if (openMatch) {
          const prefix = openMatch[2];
          return Object.keys(pages)
            .filter((name) => name.startsWith(prefix))
            .map((name) => `${openMatch[1]} ${name}`);
        }
        if (/^\S*$/.test(value)) {
          const names = [...Object.keys(commands), ...pageCommands];
          return [...new Set(names)].filter((name) => name.startsWith(value));
        }
        return [];
      };

      // Tappable version of the Tab candidates, for visitors without a
      // Tab key: chips above the input line set the tapped command as the
      // input instead of running it, so the visitor still confirms with
      // Enter. Nothing is shown while the input is empty or already
      // matches the only candidate.
      const updateSuggestions = () => {
        const candidates = input.value.trim()
          ? completionsFor(input.value).filter((candidate) => candidate !== input.value)
          : [];
        suggestions.replaceChildren(
          ...candidates.map((candidate) => {
            const chip = document.createElement("button");
            chip.type = "button";
            chip.className = "terminal__suggestion";
            chip.textContent = candidate;
            chip.addEventListener("click", () => {
              input.value = candidate;
              input.focus({ preventScroll: true });
              updateSuggestions();
            });
            return chip;
          })
        );
        suggestions.hidden = candidates.length === 0;
      };

      input.addEventListener("input", updateSuggestions);

      // The value the candidate list was last shown for. A second Tab on the
      // same value is left alone so keyboard users can move focus onward.
      let tabListedFor = null;

      input.addEventListener("keydown", (event) => {
        if (event.key !== "Tab") tabListedFor = null;
        if (event.key === "ArrowUp" || event.key === "ArrowDown") {
          if (history.length === 0) return;
          event.preventDefault();
          if (historyIndex === -1) {
            draft = input.value;
            historyIndex = history.length;
          }
          historyIndex += event.key === "ArrowUp" ? -1 : 1;
          if (historyIndex < 0) historyIndex = 0;
          if (historyIndex >= history.length) {
            historyIndex = -1;
            input.value = draft;
          } else {
            input.value = history[historyIndex];
          }
          // Keep the caret at the end after jumping through history.
          input.setSelectionRange(input.value.length, input.value.length);
          updateSuggestions();
          return;
        }
        if (event.key === "Tab" && !event.shiftKey) {
          const candidates = completionsFor(input.value);
          if (candidates.length === 0) return;
          if (candidates.length === 1) {
            // Already fully completed: let Tab move focus instead.
            if (candidates[0] === input.value) return;
            event.preventDefault();
            input.value = candidates[0];
            updateSuggestions();
            return;
          }
          let prefix = candidates[0];
          for (const candidate of candidates.slice(1)) {
            let i = 0;
            while (i < prefix.length && prefix[i] === candidate[i]) i += 1;
            prefix = prefix.slice(0, i);
          }
          if (prefix.length > input.value.length) {
            event.preventDefault();
            input.value = prefix;
            updateSuggestions();
          } else if (tabListedFor !== input.value) {
            event.preventDefault();
            tabListedFor = input.value;
            echoCommand(input.value);
            print(candidates.join("  "));
          }
        }
      });

      // Clicking the console focuses the input, unless the visitor is
      // selecting output text to copy it.
      root.addEventListener("click", () => {
        if (window.getSelection()?.toString()) return;
        input.focus({ preventScroll: true });
      });

    })();
  </script>
</BaseLayout>
