---
import ArticleCard from "@/components/ArticleCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getAllArticles, getNotes, getProjects } from "@/lib/content";
import { site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
const [articles, notes, projects] = await Promise.all([getAllArticles(), getNotes(), getProjects()]);
const recent = articles.slice(0, 6);
const recentNotes = notes.slice(0, 4);
---
<BaseLayout>
  <section class="home-hero" aria-labelledby="intro-title" data-motion>
    <div class="container">
      <div class="terminal" data-terminal>
        <div class="terminal__bar" aria-hidden="true">
          <span class="terminal__dot terminal__dot--red"></span>
          <span class="terminal__dot terminal__dot--yellow"></span>
          <span class="terminal__dot terminal__dot--green"></span>
          <span class="terminal__title">{site.name} — zsh</span>
        </div>
        <div class="home-hero__body">
          <p class="terminal__cmd">
            <span class="prompt" aria-hidden="true">$</span>
            <span class="terminal__cmd-text">cat intro.txt</span>
          </p>
          <h1 id="intro-title">{site.name}</h1>
          <p class="terminal__out">
            <span class="sr-only">{site.description}</span>
            <span aria-hidden="true" data-typing={site.description}>{site.description}</span><span class="cursor" aria-hidden="true"></span>
          </p>
          <nav class="home-hero__links" aria-label="Writing and projects">
            <a href="/articles/">Articles <span>{articles.length}</span></a>
            <a href="/notes/">Notes <span>{notes.length}</span></a>
            <a href="/projects/">Projects <span>{projects.length}</span></a>
            <a href="/tags/">Tags</a>
          </nav>
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="recent-title" data-motion>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">recent articles</p><h2 id="recent-title">Recent</h2></div>
        <div class="section-links"><a href="/articles/">Articles</a><a href="/rss.xml">RSS</a></div>
      </div>
      {recent.length ? <div class="listing-list">{recent.map((entry) => <ArticleCard entry={entry} />)}</div> : <EmptyState title="No articles yet" description="Longer write-ups will show up here." />}
    </div>
  </section>
  <section class="section" aria-labelledby="notes-title" data-motion>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">notes</p><h2 id="notes-title">Notes</h2></div>
        <a class="link-button" href="/notes/">All notes <span aria-hidden="true">↗</span></a>
      </div>
      {recentNotes.length ? <div class="listing-list">{recentNotes.map((entry) => <ArticleCard entry={entry} />)}</div> : <EmptyState title="No notes yet" description="Short memos will show up here." />}
    </div>
  </section>
  <section class="section" aria-labelledby="projects-title" data-motion>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">projects</p><h2 id="projects-title">Projects</h2></div>
        <a class="link-button" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
      </div>
      {projects.length ? <div class="project-grid">{projects.slice(0, 4).map((entry) => <ProjectCard entry={entry} />)}</div> : <EmptyState title="Nothing public yet" description="Finished work will show up here with its status." />}
    </div>
  </section>
</BaseLayout>
