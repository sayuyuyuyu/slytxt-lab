---
import ArticleCard from "@/components/ArticleCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getArticles, getProjects } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const [techPosts, lifePosts, projects] = await Promise.all([
  getArticles("tech"),
  getArticles("life"),
  getProjects()
]);

const activeProjects = projects.filter((project) =>
  ["planning", "active", "maintenance"].includes(project.data.status)
);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__content">
        <p class="eyebrow">slytxt.dev / personal notes</p>
        <h1>しらゆの<br />メモ置き場</h1>
        <p>
          AIやクラウドを試した記録と、個人で作っているもののメモ。
          たまに旅、ゲーム、音楽の話も書きます。
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="/tech/">技術メモを読む</a>
          <a class="button button--ghost" href="/about/">このサイトについて</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">notes</p>
          <h2>技術メモ</h2>
        </div>
        <a class="link-button" href="/tech/">すべて見る</a>
      </div>
      {
        techPosts.length > 0 ? (
          <div class="entry-grid">
            {techPosts.slice(0, 5).map((entry) => <ArticleCard entry={entry} />)}
          </div>
        ) : (
          <EmptyState title="まだ記事はありません" description="最初の一本を書いたら、ここに並びます。" />
        )
      }
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">journal</p>
          <h2>日々の記録</h2>
        </div>
        <a class="link-button" href="/life/">すべて見る</a>
      </div>
      {
        lifePosts.length > 0 ? (
          <div class="entry-grid">
            {lifePosts.slice(0, 5).map((entry) => <ArticleCard entry={entry} />)}
          </div>
        ) : (
          <EmptyState title="まだ記録はありません" description="出かけたことや、気に入ったものを書いていきます。" />
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">making</p>
          <h2>つくっているもの</h2>
        </div>
        <a class="link-button" href="/projects/">すべて見る</a>
      </div>
      {
        activeProjects.length > 0 ? (
          <div class="project-grid">
            {activeProjects.slice(0, 6).map((entry) => <ProjectCard entry={entry} />)}
          </div>
        ) : (
          <EmptyState title="まだ公開できるものはありません" description="形になったものから、ここに置きます。" />
        )
      }
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">about</p>
          <h2>この場所のこと</h2>
          <p>書いたものと作ったものを、あとから自分で見つけられるように残しています。</p>
        </div>
        <a class="button" href="/about/">プロフィールを見る</a>
      </div>
    </div>
  </section>
</BaseLayout>
