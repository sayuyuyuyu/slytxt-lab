---
import { getArticles, getAdjacentArticles, getEntrySlug } from "@/lib/content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getArticles("life");
  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = await getArticles("life");
const { previous, next } = getAdjacentArticles(entries, entry.id);
---

<ArticleLayout entry={entry} headings={headings} previous={previous} next={next}>
  <Content />
</ArticleLayout>
