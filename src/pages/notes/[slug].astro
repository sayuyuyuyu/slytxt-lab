---
import { getAdjacentArticles, getEntrySlug, getNotes } from "@/lib/content";
import NoteLayout from "@/layouts/NoteLayout.astro";

export async function getStaticPaths() {
  const entries = await getNotes();
  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const entries = await getNotes();
const { previous, next } = getAdjacentArticles(entries, entry.id);
---

<NoteLayout entry={entry} previous={previous} next={next} />
