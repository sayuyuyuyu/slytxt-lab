---
import { getNotes } from "@/lib/content";
import { pageCount, paginateEntries } from "@/lib/pagination";
import { articleSections } from "@/lib/site";
import ArticleListing from "@/layouts/ArticleListing.astro";
export async function getStaticPaths() {
  const entries = await getNotes();
  return Array.from({ length: pageCount(entries.length) - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: paginateEntries(entries, "/notes", index + 2) }
  }));
}
const { page } = Astro.props;
---
<ArticleListing section={articleSections.notes} basePath="/notes" page={page} />
