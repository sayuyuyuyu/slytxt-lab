---
import { getNotes } from "@/lib/content";
import { pagedStaticPaths } from "@/lib/pagination";
import { articleSections } from "@/lib/site";
import ArticleListing from "@/layouts/ArticleListing.astro";
export async function getStaticPaths() {
  const entries = await getNotes();
  return pagedStaticPaths(entries, "/notes");
}
const { page } = Astro.props;
---
<ArticleListing section={articleSections.notes} basePath="/notes" page={page} variant="note" />
