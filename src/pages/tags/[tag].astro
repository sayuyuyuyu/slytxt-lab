---
import { collectTags } from "@/lib/tags";
import { getAllEntries, getEntriesByTag } from "@/lib/content";
import { paginateEntries } from "@/lib/pagination";
import TagListing from "@/layouts/TagListing.astro";

export async function getStaticPaths() {
  const entries = await getAllEntries();
  const tags = collectTags(entries);

  return Array.from(tags.entries()).map(([slug, label]) => ({
    params: { tag: slug },
    props: { label }
  }));
}

const { tag } = Astro.params;
const { label } = Astro.props;
const entries = getEntriesByTag(await getAllEntries(), tag ?? "");
const page = paginateEntries(entries, `/tags/${tag ?? ""}`);
---

<TagListing label={label} tag={tag ?? ""} page={page} />
