---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import EmptyState from "@/components/EmptyState.astro";
import { getAllEntries, getEntriesByTag } from "@/lib/content";
import { site } from "@/lib/site";
import { collectTags } from "@/lib/tags";
const entries = await getAllEntries();
const tags = Array.from(collectTags(entries), ([slug, label]) => ({ slug, label, count: getEntriesByTag(entries, slug).length }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, "ja"));
---
<BaseLayout title={`Tags - ${site.name}`} description="Tech、Journal、Notes、Projects をタグから辿れます。">
  <PageHeader title="Tags" eyebrow="tags" count={tags.length} countLabel="tags" countLabelOne="tag" />
  <section class="listing" aria-label="Tags"><div class="container">
    {tags.length ? <ul class="tag-directory">{tags.map((tag) => <li data-motion><a href={`/tags/${tag.slug}/`}>#{tag.label}<span>{tag.count}</span></a></li>)}</ul> : <EmptyState title="No tags yet" description="They will show up once there are more entries." />}
  </div></section>
</BaseLayout>
