---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { site } from "@/lib/site";
---
<BaseLayout title={`Not found - ${site.name}`} noindex>
  <PageHeader title="Not found" eyebrow="404 / not found" />
  <section class="listing"><div class="container section-links">
    <a class="button button--primary" href="/">Back home</a>
    <a class="button" href="/search/">Search</a>
  </div></section>
</BaseLayout>
