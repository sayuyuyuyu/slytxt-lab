---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
---
<BaseLayout title="ページが見つかりません - しらゆラボ" noindex>
  <PageHeader title="ページが見つかりません" eyebrow="404 / not found" description="URLが変わったか、ページが消えています。" />
  <section class="listing"><div class="container section-links">
    <a class="button button--primary" href="/">ホームに戻る</a>
    <a class="button" href="/search/">検索する</a>
  </div></section>
</BaseLayout>
