---
import { getArticles } from "@/lib/content";
import { paginateEntries } from "@/lib/pagination";
import { articleSections } from "@/lib/site";
import ArticleListing from "@/layouts/ArticleListing.astro";
const page = paginateEntries(await getArticles("tech"), "/articles/tech");
---
<ArticleListing section={articleSections.tech} basePath="/articles/tech" page={page} />
