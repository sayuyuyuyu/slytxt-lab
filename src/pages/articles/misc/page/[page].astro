---
import { getArticles } from "@/lib/content";
import { pagedStaticPaths } from "@/lib/pagination";
import { articleSections } from "@/lib/site";
import ArticleListing from "@/layouts/ArticleListing.astro";
export async function getStaticPaths() {
  const entries = await getArticles("misc");
  return pagedStaticPaths(entries, "/articles/misc");
}
const { page } = Astro.props;
---
<ArticleListing section={articleSections.misc} basePath="/articles/misc" page={page} />
