---
import { getArticles } from "@/lib/content";
import { pageCount, paginateEntries } from "@/lib/pagination";
import { articleSections } from "@/lib/site";
import ArticleListing from "@/layouts/ArticleListing.astro";
export async function getStaticPaths() {
  const entries = await getArticles("journal");
  return Array.from({ length: pageCount(entries.length) - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: paginateEntries(entries, "/articles/journal", index + 2) }
  }));
}
const { page } = Astro.props;
---
<ArticleListing section={articleSections.journal} basePath="/articles/journal" page={page} />
