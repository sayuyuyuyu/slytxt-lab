---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import TagList from "@/components/TagList.astro";
import { getEntryDescription, getEntryDisplayTitle, getEntrySlug, getProjects, hasXEmbed } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels, projectStatusLabels, site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getProjects();
  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const displayTitle = getEntryDisplayTitle(entry);
const lead = entry.data.description !== displayTitle ? entry.data.description : undefined;
const crumbs = [{ label: "Projects", href: "/projects/" }, { label: displayTitle }];
---

<BaseLayout
  title={`${displayTitle} - Projects - ${site.name}`}
  description={getEntryDescription(entry)}
  image={`/og/projects/${getEntrySlug(entry)}.png`}
  headline={displayTitle}
  published={entry.data.started}
  updated={entry.data.updated}
  creativeWork
  searchable
  loadXWidgets={hasXEmbed(entry.body)}
  breadcrumbs={crumbs}
>
  <header class="article-hero" data-motion>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{categoryLabels.projects}</p>
      <h1 class="page-title" data-pagefind-meta="title">{displayTitle}</h1>
      {lead && <p class="page-lead">{lead}</p>}
      <div class="article-meta">
        <span class="status">{projectStatusLabels[entry.data.status]}</span>
        <span>Started <time datetime={entry.data.started.toISOString()}>{formatDate(entry.data.started)}</time></span>
        {entry.data.updated && <span>Updated <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time></span>}
      </div>
      <TagList tags={entry.data.tags} />
    </div>
  </header>
  <div class:list={["article-shell", { "article-shell--wide": !headings.some((heading) => heading.depth === 2 || heading.depth === 3) }]}>
    <article class="article-main" data-pagefind-filter={`category:${categoryLabels.projects}`}>
      <div class="article-body">
        <Content />
      </div>
      {(entry.data.repo || entry.data.demo) && (
        <nav class="article-nav" aria-label="Project links" data-pagefind-ignore data-motion>
          {entry.data.repo && <a href={entry.data.repo} rel="noreferrer"><span>Repository</span>{entry.data.repo}</a>}
          {entry.data.demo && <a href={entry.data.demo} rel="noreferrer"><span>Demo</span>{entry.data.demo}</a>}
        </nav>
      )}
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
