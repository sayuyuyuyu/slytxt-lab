---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import TagList from "@/components/TagList.astro";
import { getEntrySlug, getProjects } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels, projectStatusLabels } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getProjects();
  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const date = entry.data.updated ?? entry.data.started;
---

<BaseLayout
  title={`${entry.data.title} - つくったもの - しらゆラボ`}
  description={entry.data.description}
  image={`/og/projects/${getEntrySlug(entry)}.png`}
  type="article"
  published={entry.data.started}
  updated={entry.data.updated}
  searchable
>
  <header class="article-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "つくったもの", href: "/projects/" }, { label: entry.data.title }]} />
      <p class="eyebrow">{categoryLabels.projects}</p>
      <h1 class="page-title" data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="page-lead">{entry.data.description}</p>
      <div class="article-meta">
        <span class="status">{projectStatusLabels[entry.data.status]}</span>
        <span aria-hidden="true"> / </span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </div>
      <TagList tags={entry.data.tags} />
    </div>
  </header>
  <div class:list={["article-shell", { "article-shell--wide": !headings.some((heading) => heading.depth === 2 || heading.depth === 3) }]}>
    <TableOfContents headings={headings} />
    <article class="article-main" data-pagefind-filter={`種類:${categoryLabels.projects}`}>
      <div class="article-body">
        <Content />
      </div>
      <div class="article-nav" data-pagefind-ignore>
        {entry.data.repo && <a href={entry.data.repo} rel="noreferrer"><span>Repository</span>{entry.data.repo}</a>}
        {entry.data.demo && <a href={entry.data.demo} rel="noreferrer"><span>Demo</span>{entry.data.demo}</a>}
      </div>
    </article>
  </div>
</BaseLayout>
