---
import EmptyState from "@/components/EmptyState.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getProjects } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = await getProjects();
---

<BaseLayout title="つくったもの - しらゆラボ" description="しらゆが個人でつくっているものをまとめています。">
  <PageHeader
    eyebrow="making"
    title="つくったもの"
    description="個人でつくっているものを、進み具合と一緒にまとめます。"
    count={projects.length}
  />
  <section class="listing">
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((entry) => <ProjectCard entry={entry} headingLevel="h2" />)}
          </div>
        ) : (
          <EmptyState title="まだ公開できるものはありません" description="形になったものから、ここに置きます。" />
        )
      }
    </div>
  </section>
</BaseLayout>
