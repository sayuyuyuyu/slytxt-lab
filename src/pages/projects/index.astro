---
import EmptyState from "@/components/EmptyState.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getProjects } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = await getProjects();
---

<BaseLayout title="つくったもの - しらゆラボ" description="しらゆが個人でつくっているものをまとめています。">
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">making</p>
      <h1 class="page-title">つくったもの</h1>
      <p class="page-lead">個人でつくっているものを、進み具合と一緒にまとめます。</p>
    </div>
  </header>
  <section class="listing">
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((entry) => <ProjectCard entry={entry} />)}
          </div>
        ) : (
          <EmptyState title="まだ公開できるものはありません" description="形になったものから、ここに置きます。" />
        )
      }
    </div>
  </section>
</BaseLayout>
