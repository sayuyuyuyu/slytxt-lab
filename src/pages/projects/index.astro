---
import EmptyState from "@/components/EmptyState.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getProjects } from "@/lib/content";
import { site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = await getProjects();
---

<BaseLayout title={`Projects - ${site.name}`} description="しらゆがつくっているものと、いまの進み具合。">
  <PageHeader
    eyebrow="making"
    title="Projects"
    count={projects.length}
    countLabel="projects"
    countLabelOne="project"
  />
  <section class="listing">
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((entry) => <ProjectCard entry={entry} headingLevel="h2" />)}
          </div>
        ) : (
          <EmptyState title="Nothing public yet" description="Finished work will show up here." />
        )
      }
    </div>
  </section>
</BaseLayout>
