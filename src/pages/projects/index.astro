---
import EmptyState from "@/components/EmptyState.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getProjects } from "@/lib/content";
import { emptyStateTitles, pageDescriptions, site } from "@/lib/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = await getProjects();
---

<BaseLayout title={`Projects - ${site.name}`} description={pageDescriptions.projects}>
  <PageHeader
    eyebrow="projects"
    title="Projects"
    count={projects.length}
    countLabel="projects"
    countLabelOne="project"
  />
  <section class="listing">
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((entry) => <ProjectCard entry={entry} headingLevel="h2" />)}
          </div>
        ) : (
          <EmptyState title={emptyStateTitles.projects} description="まだありません。つくったものが進み具合と一緒にここに並びます。" />
        )
      }
    </div>
  </section>
</BaseLayout>
