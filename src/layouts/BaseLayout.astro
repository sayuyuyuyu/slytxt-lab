---
import SiteEggs from "@/components/SiteEggs.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "@/lib/og";
import { site } from "@/lib/site";
import "@/styles/global.css";

type Props = {
  title?: string;
  headline?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  noCanonical?: boolean;
  searchable?: boolean;
  loadXWidgets?: boolean;
  creativeWork?: boolean;
  profilePage?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
};

const {
  title = site.title,
  headline = title,
  description = site.description,
  image = "/og/site.png",
  type = "website",
  published,
  updated,
  noindex = false,
  noCanonical = false,
  searchable = false,
  loadXWidgets = false,
  creativeWork = false,
  profilePage = false,
  breadcrumbs
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
// The default OG image shows only the site name and description, not the
// page title, so its alt follows the image content instead of the title.
const imageAlt = image === "/og/site.png" ? site.name : title;
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: new URL("/", Astro.site).href,
  description: site.description,
  inLanguage: site.lang
};
const authorJsonLd = {
  "@type": "Person",
  name: "しらゆ（slytxt）"
};
const postingJsonLd =
  type === "article" && published
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline,
        description,
        image: imageUrl.href,
        author: authorJsonLd,
        datePublished: published.toISOString(),
        dateModified: (updated ?? published).toISOString(),
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        inLanguage: site.lang
      }
    : undefined;
const workJsonLd =
  creativeWork && published
    ? {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        headline,
        description,
        image: imageUrl.href,
        author: authorJsonLd,
        datePublished: published.toISOString(),
        dateModified: (updated ?? published).toISOString(),
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        inLanguage: site.lang
      }
    : undefined;
const profileJsonLd = profilePage
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      url: canonical.href,
      inLanguage: site.lang,
      mainEntity: {
        ...authorJsonLd,
        alternateName: "slytxt",
        url: canonical.href
      }
    }
  : undefined;
const breadcrumbJsonLd =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: new URL("/", Astro.site).href
          },
          ...breadcrumbs.map((item, index) => ({
            "@type": "ListItem",
            position: index + 2,
            name: item.label,
            ...(item.href && index < breadcrumbs.length - 1
              ? { item: new URL(item.href, Astro.site).href }
              : {})
          }))
        ]
      }
    : undefined;
// A literal "<" inside the JSON could close the script element early.
const toJsonLd = (data: unknown) => JSON.stringify(data).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#1f2d40" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        // 紺のダークが既定。`light` は明示的に選んだときだけ。
        try {
          const isLight = localStorage.getItem("theme") === "light";
          document.documentElement.classList.toggle("light", isLight);
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", isLight ? "#f2f2f2" : "#1f2d40");
        } catch {
          // Storage unavailable: stay on the default dark palette.
        }
      })();
    </script>
    <script is:inline>
      // 直前の操作がキーボードかポインタかを html に持たせる（skip-link の表示に使う）。
      // 読み込み直後はポインタ扱いにして、フォーカスの復元で skip-link を出さない。
      document.documentElement.dataset.input = "pointer";
      window.addEventListener(
        "pointerdown",
        () => {
          document.documentElement.dataset.input = "pointer";
        },
        { passive: true }
      );
      window.addEventListener("keydown", (event) => {
        if (event.key === "Tab") document.documentElement.dataset.input = "keyboard";
      });
    </script>
    <script is:inline>
      // 出現アニメーションが動かない場合でも内容が消えないように。
      // 正常に初期化できた場合は、画面外要素の出現を IntersectionObserver に任せる。
      window.addEventListener("load", () => {
        window.setTimeout(() => {
          if (document.documentElement.dataset.motionReady === "true") return;
          document.querySelectorAll("[data-motion]").forEach((el) => {
            if (Number(getComputedStyle(el).opacity) < 0.05) {
              el.style.opacity = "1";
              el.style.transform = "none";
            }
          });
        }, 2000);
      });
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noCanonical && <link rel="canonical" href={canonical.href} />}
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    {type === "article" && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === "article" && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script type="application/ld+json" set:html={toJsonLd(websiteJsonLd)} />
    {postingJsonLd && <script type="application/ld+json" set:html={toJsonLd(postingJsonLd)} />}
    {workJsonLd && <script type="application/ld+json" set:html={toJsonLd(workJsonLd)} />}
    {profileJsonLd && <script type="application/ld+json" set:html={toJsonLd(profileJsonLd)} />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={toJsonLd(breadcrumbJsonLd)} />}
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={searchable ? undefined : "all"}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <div class="site-shell">
      <main id="main-content" class="site-main" tabindex="-1" data-pagefind-body={searchable || undefined}>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script is:inline>
      // 出現アニメーションは IntersectionObserver + CSS transition で行う
      // （以前は motion パッケージを使っていたが、全ページで読むには重い）。
      // 動きの仕様は従来どおり: 画面に入ったら、兄弟要素の並び順に
      // 少しずつ遅らせてふわりと出す。
      (() => {
        document.documentElement.dataset.motionReady = "true";
        const targets = Array.from(document.querySelectorAll("[data-motion]"));
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !("IntersectionObserver" in window)) {
          for (const el of targets) el.classList.add("is-shown");
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target;
              const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
              const delay = Math.min(Math.max(siblings.indexOf(el), 0), 6) * 45;
              el.style.transitionDelay = `${delay}ms`;
              el.classList.add("is-shown");
              io.unobserve(el);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        for (const el of targets) io.observe(el);
      })();
    </script>
    {loadXWidgets && <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8" />}
    <SiteEggs />
  </body>
</html>
