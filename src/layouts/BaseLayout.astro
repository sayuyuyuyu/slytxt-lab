---
import SiteEggs from "@/components/SiteEggs.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "@/lib/og";
import { site } from "@/lib/site";
import "@/styles/global.css";

type Props = {
  title?: string;
  headline?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  noCanonical?: boolean;
  searchable?: boolean;
  loadXWidgets?: boolean;
  creativeWork?: boolean;
  profilePage?: boolean;
};

const {
  title = site.title,
  headline = title,
  description = site.description,
  image = "/og/site.png",
  type = "website",
  published,
  updated,
  noindex = false,
  noCanonical = false,
  searchable = false,
  loadXWidgets = false,
  creativeWork = false,
  profilePage = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
// The default OG image shows only the site name and description, not the
// page title, so its alt follows the image content instead of the title.
const imageAlt = image === "/og/site.png" ? site.name : title;
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: new URL("/", Astro.site).href,
  description: site.description,
  inLanguage: site.lang
};
const authorJsonLd = {
  "@type": "Person",
  name: "しらゆ（slytxt）"
};
const postingJsonLd =
  type === "article" && published
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline,
        description,
        image: imageUrl.href,
        author: authorJsonLd,
        datePublished: published.toISOString(),
        dateModified: (updated ?? published).toISOString(),
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        inLanguage: site.lang
      }
    : undefined;
const workJsonLd =
  creativeWork && published
    ? {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        headline,
        description,
        image: imageUrl.href,
        author: authorJsonLd,
        datePublished: published.toISOString(),
        dateModified: (updated ?? published).toISOString(),
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        inLanguage: site.lang
      }
    : undefined;
const profileJsonLd = profilePage
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      url: canonical.href,
      inLanguage: site.lang,
      mainEntity: {
        ...authorJsonLd,
        alternateName: "slytxt",
        url: canonical.href
      }
    }
  : undefined;
// A literal "<" inside the JSON could close the script element early.
const toJsonLd = (data: unknown) => JSON.stringify(data).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#05070f" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        // Blue-black terminal is the default look. `light` is an explicit opt-in.
        try {
          const isLight = localStorage.getItem("theme") === "light";
          document.documentElement.classList.toggle("light", isLight);
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", isLight ? "#eef3fb" : "#05070f");
        } catch {
          // Storage unavailable: stay on the default dark palette.
        }
      })();
    </script>
    <script is:inline>
      // Motion が読み込めない・動かない場合でも内容が消えないように。
      // Motion が正常に初期化できた場合は、画面外要素の出現を inView に任せる。
      window.addEventListener("load", () => {
        window.setTimeout(() => {
          if (document.documentElement.dataset.motionReady === "true") return;
          document.querySelectorAll("[data-motion]").forEach((el) => {
            if (Number(getComputedStyle(el).opacity) < 0.05) {
              el.style.opacity = "1";
              el.style.transform = "none";
            }
          });
        }, 2000);
      });
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noCanonical && <link rel="canonical" href={canonical.href} />}
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    {type === "article" && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === "article" && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script type="application/ld+json" set:html={toJsonLd(websiteJsonLd)} />
    {postingJsonLd && <script type="application/ld+json" set:html={toJsonLd(postingJsonLd)} />}
    {workJsonLd && <script type="application/ld+json" set:html={toJsonLd(workJsonLd)} />}
    {profileJsonLd && <script type="application/ld+json" set:html={toJsonLd(profileJsonLd)} />}
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={searchable ? undefined : "all"}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <div class="site-shell">
      <main id="main-content" class="site-main" tabindex="-1" data-pagefind-body={searchable || undefined}>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import { animate, inView } from "motion";

      document.documentElement.dataset.motionReady = "true";
      const EASE: [number, number, number, number] = [0.22, 1, 0.36, 1];
      const targets = Array.from(document.querySelectorAll<HTMLElement>("[data-motion]"));
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const show = (el: HTMLElement, delay: number) => {
        animate(el, { opacity: 1, y: 0 }, { duration: 0.7, delay, ease: EASE });
      };

      if (reduce) {
        for (const el of targets) {
          el.style.opacity = "1";
          el.style.transform = "none";
        }
      } else {
        for (const el of targets) {
          const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
          const delay = Math.min(Math.max(siblings.indexOf(el), 0), 6) * 0.045;
          let stop = () => {};
          stop = inView(
            el,
            () => {
              show(el, delay);
              stop();
            },
            { amount: 0.12, margin: "0px 0px -8% 0px" }
          );
        }
      }
    </script>
    {loadXWidgets && <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8" />}
    <SiteEggs />
  </body>
</html>
