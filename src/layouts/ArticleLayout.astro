---
import AdultGate from "@/components/AdultGate.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import TagList from "@/components/TagList.astro";
import { getEntryPath, getEntrySlug, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels, categoryPaths, site } from "@/lib/site";
import BaseLayout from "./BaseLayout.astro";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  entry: ArticleEntry;
  headings: Heading[];
  previous?: ArticleEntry;
  next?: ArticleEntry;
};

const { entry, headings, previous, next } = Astro.props;
const date = entry.data.updated ?? entry.data.published;
const title = `${entry.data.title} - ${categoryLabels[entry.collection]} - ${site.name}`;
const ogImage = `/og/${entry.collection}/${getEntrySlug(entry)}.png`;
const crumbs =
  entry.collection === "notes"
    ? [
        { label: categoryLabels.notes, href: categoryPaths.notes },
        { label: entry.data.title }
      ]
    : [
        { label: "Articles", href: "/articles/" },
        { label: categoryLabels[entry.collection], href: categoryPaths[entry.collection] },
        { label: entry.data.title }
      ];
---

<BaseLayout
  title={title}
  description={entry.data.description}
  image={ogImage}
  type="article"
  published={entry.data.published}
  updated={entry.data.updated}
  searchable
>
  <header class="article-hero" data-motion>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{categoryLabels[entry.collection]}</p>
      <h1 class="page-title" data-pagefind-meta="title">{entry.data.title}</h1>
      {entry.data.description && <p class="page-lead">{entry.data.description}</p>}
      <div class="article-meta">
        <span>Published <time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></span>
        {entry.data.updated && <span>Updated <time datetime={date.toISOString()}>{formatDate(date)}</time></span>}
        {entry.data.adult && <span aria-label="Includes an adult content review"> / 🔞</span>}
      </div>
      <TagList tags={entry.data.tags} />
    </div>
  </header>

  <div class:list={["article-shell", { "article-shell--wide": !headings.some((heading) => heading.depth === 2 || heading.depth === 3) }]}>
    <TableOfContents headings={headings} />
    <article class="article-main" data-pagefind-filter={`category:${categoryLabels[entry.collection]}`}>
      {entry.data.adult && <AdultGate storageKey="adult-content-consent" />}
      <div class="article-body" data-adult-content data-locked={entry.data.adult ? "true" : "false"}>
        <slot />
      </div>

      <nav class="article-nav" aria-label="Article navigation" data-pagefind-ignore data-motion>
        {
          previous ? (
            <a href={getEntryPath(previous)}>
              <span>Previous</span>
              {previous.data.title}
            </a>
          ) : (
            <span></span>
          )
        }
        {
          next ? (
            <a href={getEntryPath(next)}>
              <span>Next</span>
              {next.data.title}
            </a>
          ) : (
            <span></span>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>
