---
import AdultGate from "@/components/AdultGate.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import TagList from "@/components/TagList.astro";
import { getEntryDate, getEntryDescription, getEntryDisplayTitle, getEntryPath, getEntrySlug, hasXEmbed, type TechJournalEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels, categoryPaths, site } from "@/lib/site";
import BaseLayout from "./BaseLayout.astro";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  entry: TechJournalEntry;
  headings: Heading[];
  previous?: TechJournalEntry;
  next?: TechJournalEntry;
};

const { entry, headings, previous, next } = Astro.props;
const date = getEntryDate(entry);
const displayTitle = getEntryDisplayTitle(entry);
const title = `${displayTitle} - ${categoryLabels[entry.collection]} - ${site.name}`;
const description = getEntryDescription(entry);
const lead = entry.data.description && entry.data.description !== displayTitle ? entry.data.description : undefined;
const ogImage = `/og/${entry.collection}/${getEntrySlug(entry)}.png`;
const crumbs = [
  { label: "Articles", href: "/articles/" },
  { label: categoryLabels[entry.collection], href: categoryPaths[entry.collection] },
  { label: displayTitle }
];
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  type="article"
  published={entry.data.published}
  updated={entry.data.updated}
  searchable
  loadXWidgets={hasXEmbed(entry.body)}
>
  <header class="article-hero" data-motion>
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{categoryLabels[entry.collection]}</p>
      <h1 class="page-title" data-pagefind-meta="title">{displayTitle}</h1>
      {lead && <p class="page-lead">{lead}</p>}
      <div class="article-meta">
        <span>Published <time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></span>
        {entry.data.updated && <span>Updated <time datetime={date.toISOString()}>{formatDate(date)}</time></span>}
        {entry.data.adult && <span role="img" aria-label="Includes an adult content review"> / 🔞</span>}
      </div>
      <TagList tags={entry.data.tags} />
      {entry.data.cover && <img class="article-cover" src={entry.data.cover} alt="" />}
    </div>
  </header>

  <div class:list={["article-shell", { "article-shell--wide": !headings.some((heading) => heading.depth === 2 || heading.depth === 3) }]}>
    <article class="article-main" data-pagefind-filter={`category:${categoryLabels[entry.collection]}`}>
      {entry.data.adult && <AdultGate storageKey="adult-content-consent" />}
      <div class="article-body" data-adult-content data-locked={entry.data.adult ? "true" : "false"}>
        <slot />
      </div>

      <nav class="article-nav" aria-label="Article navigation" data-pagefind-ignore data-motion>
        {
          previous ? (
            <a href={getEntryPath(previous)}>
              <span>Previous</span>
              {getEntryDisplayTitle(previous)}
            </a>
          ) : (
            <span></span>
          )
        }
        {
          next ? (
            <a href={getEntryPath(next)}>
              <span>Next</span>
              {getEntryDisplayTitle(next)}
            </a>
          ) : (
            <span></span>
          )
        }
      </nav>
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
