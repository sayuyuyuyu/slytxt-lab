---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TagList from "@/components/TagList.astro";
import { getEntryDate, getEntryDisplayTitle, getEntryPath, getEntrySlug, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels, categoryPaths, site } from "@/lib/site";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  entry: ArticleEntry;
  previous?: ArticleEntry;
  next?: ArticleEntry;
};

const { entry, previous, next } = Astro.props;
const date = getEntryDate(entry);
const text = (entry.body ?? "").trim();
const label = getEntryDisplayTitle(entry);
const ogImage = `/og/${entry.collection}/${getEntrySlug(entry)}.png`;

const navTitle = (target: ArticleEntry) => getEntryDisplayTitle(target);
---

<BaseLayout
  title={`${label} - ${categoryLabels.notes} - ${site.name}`}
  description={entry.data.description ?? label}
  image={ogImage}
  type="article"
  published={entry.data.published}
  updated={entry.data.updated}
  searchable
>
  <article class="note" data-pagefind-filter={`category:${categoryLabels.notes}`}>
    <div class="container note__inner">
      <Breadcrumbs items={[{ label: "Notes", href: categoryPaths.notes }, { label }]} />
      <h1 class="sr-only">{label}</h1>
      <p class="note__meta">
        <span>{categoryLabels.notes}</span>
        <span aria-hidden="true"> / </span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>
      {entry.data.cover && <img class="note-cover" src={entry.data.cover} alt="" loading="lazy" />}
      <pre class="note__text">{text}</pre>
      <TagList tags={entry.data.tags} />
      <nav class="article-nav" aria-label="Note navigation" data-pagefind-ignore data-motion>
        {previous ? (
          <a href={getEntryPath(previous)}>
            <span>Previous</span>
            {navTitle(previous)}
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={getEntryPath(next)}>
            <span>Next</span>
            {navTitle(next)}
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>
