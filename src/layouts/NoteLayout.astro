---
import AdultGate from "@/components/AdultGate.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import TagList from "@/components/TagList.astro";
import { getEntryDisplayTitle, getEntryPath, getEntryPreview, getEntrySlug, type ArticleEntry } from "@/lib/content";
import { formatDate } from "@/lib/format";
import { categoryLabels, categoryPaths, site } from "@/lib/site";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  entry: ArticleEntry;
  previous?: ArticleEntry;
  next?: ArticleEntry;
};

const { entry, previous, next } = Astro.props;
const text = (entry.body ?? "").trim();
const label = getEntryDisplayTitle(entry);
const preview = getEntryPreview(entry, 200);
const description = entry.data.description ?? (preview && preview !== label ? preview : undefined);
const ogImage = `/og/${entry.collection}/${getEntrySlug(entry)}.png`;

const navTitle = (target: ArticleEntry) => getEntryDisplayTitle(target);
---

<BaseLayout
  title={`${label} - ${categoryLabels.notes} - ${site.name}`}
  description={description}
  image={ogImage}
  type="article"
  published={entry.data.published}
  updated={entry.data.updated}
  searchable
>
  <article class="note" data-motion data-pagefind-filter={`category:${categoryLabels.notes}`}>
    <div class="container note__inner">
      <Breadcrumbs items={[{ label: "Notes", href: categoryPaths.notes }, { label }]} />
      <h1 class="sr-only" data-pagefind-meta="title">{label}</h1>
      <p class="note__meta">
        <span>{categoryLabels.notes}</span>
        <span>Published <time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></span>
        {entry.data.updated && <span>Updated <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated)}</time></span>}
        {entry.data.adult && <span role="img" aria-label="Includes an adult content review"> / 🔞</span>}
      </p>
      {entry.data.cover && <img class="note-cover" src={entry.data.cover} alt="" />}
      {entry.data.adult && <AdultGate storageKey="adult-content-consent" />}
      <pre class="note__text" data-adult-content data-locked={entry.data.adult ? "true" : "false"}>{text}</pre>
      <TagList tags={entry.data.tags} />
      <nav class="article-nav" aria-label="Note navigation" data-pagefind-ignore data-motion>
        {previous ? (
          <a href={getEntryPath(previous)}>
            <span>Previous</span>
            {navTitle(previous)}
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={getEntryPath(next)}>
            <span>Next</span>
            {navTitle(next)}
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>
