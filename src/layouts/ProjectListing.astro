---
import EmptyState from "@/components/EmptyState.astro";
import PageHeader from "@/components/PageHeader.astro";
import Pagination from "@/components/Pagination.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { type ProjectEntry } from "@/lib/content";
import { type PageData } from "@/lib/pagination";
import { emptyStateTitles, pageDescriptions, site } from "@/lib/site";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  page: PageData<ProjectEntry>;
};
const { page } = Astro.props;
const suffix = page.currentPage > 1 ? ` (page ${page.currentPage})` : "";
---

<BaseLayout title={`Projects${suffix} - ${site.name}`} description={pageDescriptions.projects}>
  <PageHeader
    eyebrow="projects"
    title="Projects"
    count={page.totalEntries}
    countLabel="projects"
    countLabelOne="project"
  />
  <section class="listing" aria-label="Projects listing">
    <div class="container">
      {
        page.entries.length > 0 ? (
          <div class="project-grid">
            {page.entries.map((entry) => <ProjectCard entry={entry} headingLevel="h2" />)}
          </div>
        ) : (
          <EmptyState title={emptyStateTitles.projects} description="まだありません。つくったものが進み具合と一緒にここに並びます。" />
        )
      }
      <Pagination basePath="/projects" {...page} />
    </div>
  </section>
</BaseLayout>
