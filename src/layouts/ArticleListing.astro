---
import ArticleCard from "@/components/ArticleCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import PageHeader from "@/components/PageHeader.astro";
import Pagination from "@/components/Pagination.astro";
import TagFilter from "@/components/TagFilter.astro";
import { getAllEntries, type ArticleEntry } from "@/lib/content";
import { type PageData } from "@/lib/pagination";
import { type ArticleSection, site } from "@/lib/site";
import { tagCounts } from "@/lib/tags";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  section: ArticleSection;
  basePath: string;
  page: PageData<ArticleEntry>;
};
const { section, basePath, page } = Astro.props;
const suffix = page.currentPage > 1 ? ` (page ${page.currentPage})` : "";
// タグはサイト全体から集める（絞り込みはこのページのカードに当てる）。
const tags = tagCounts(await getAllEntries());
---
<BaseLayout title={`${section.title}${suffix} - ${site.name}`} description={section.description}>
  <PageHeader title={`${section.title}${suffix}`} count={page.totalEntries} countLabel="entries" countLabelOne="entry" />
  <section class="listing" aria-label={`${section.title} listing`}>
    <div class="container">
      <TagFilter tags={tags} basePath={basePath} />
      {page.entries.length > 0 ? (
        <div class="listing-list">
          {page.entries.map((entry) => <ArticleCard entry={entry} headingLevel="h2" />)}
        </div>
      ) : <EmptyState title={section.emptyTitle} description={section.emptyDescription} />}
      <Pagination basePath={basePath} {...page} />
    </div>
  </section>
</BaseLayout>
