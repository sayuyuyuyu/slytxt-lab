---
import PageHeader from "@/components/PageHeader.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Pagination from "@/components/Pagination.astro";
import type { SiteEntry } from "@/lib/content";
import type { PageData } from "@/lib/pagination";
import { site } from "@/lib/site";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  label: string;
  tag: string;
  page: PageData<SiteEntry>;
};
const { label, tag, page } = Astro.props;
const basePath = `/tags/${tag}`;
const suffix = page.currentPage > 1 ? ` (page ${page.currentPage})` : "";
// 並びは日付の新しい順（src/lib/content.ts の getAllEntries）。区分ごとの
// 見出しで分けると、ページ送りの境界で見出しが分断されるため、1つの一覧に出す（#698）。
const entries = page.entries;
const breadcrumbs = [{ label: "Tags", href: "/tags/" }, { label: `#${label}` }];
---

<BaseLayout title={`#${label}${suffix} - Tags - ${site.name}`} description={`#${label} が付いた記事とつくったもの。`} breadcrumbs={breadcrumbs}>
  <PageHeader
    title={`#${label}${suffix}`}
    count={page.totalEntries}
    countLabel="entries"
    countLabelOne="entry"
    breadcrumbs={breadcrumbs}
  />
  <section class="listing" aria-label="Tag listing">
    <div class="container">
      <div class="listing-list">
        {entries.map((entry) =>
          entry.collection === "projects" ? (
            <ProjectCard entry={entry} />
          ) : (
            <ArticleCard entry={entry} />
          )
        )}
      </div>
      <Pagination basePath={basePath} {...page} />
    </div>
  </section>
</BaseLayout>
